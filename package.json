{
  "name": "@nabla/engine",
  "version": "0.2.0",
  "description": "Independent scene, simulation and editing foundation for Nabla applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run build:demo",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "3d",
    "engine",
    "webgl",
    "scene",
    "editor",
    "vehicle",
    "physics"
  ],
  "author": "Nabla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txemavs/nabla-engine.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "cannon-es": "^0.20.0",
    "pbf": "^4.0.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "lerc": "^4.2.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
