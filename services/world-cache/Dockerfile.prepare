FROM node:22-alpine AS build
WORKDIR /build
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --ignore-scripts
COPY tsconfig*.json ./
COPY src ./src
COPY services/world-cache/planet ./services/world-cache/planet
COPY services/world-cache/prepare ./services/world-cache/prepare
COPY services/world-cache/export ./services/world-cache/export
RUN npx tsc -p tsconfig.prepare.json

FROM node:22-alpine
RUN apk add --no-cache python3
WORKDIR /app
COPY --from=build /build/prepare-dist ./prepare-dist
COPY --from=build /build/node_modules/three ./node_modules/three
COPY --from=build /build/node_modules/zod ./node_modules/zod
COPY --from=build /build/node_modules/@dimforge/rapier3d-compat ./node_modules/@dimforge/rapier3d-compat
COPY --from=build /build/node_modules/lerc ./node_modules/lerc
COPY --from=build /build/node_modules/jpeg-js ./node_modules/jpeg-js
COPY --from=build /build/node_modules/polygon-clipping ./node_modules/polygon-clipping
COPY --from=build /build/node_modules/robust-predicates ./node_modules/robust-predicates
COPY --from=build /build/node_modules/splaytree ./node_modules/splaytree
COPY package.json ./
COPY services/world-cache/cache ./cache
COPY services/world-cache/planet ./planet
COPY services/world-cache/geoeuskadi ./geoeuskadi
ENV PYTHONPATH=/app
USER 1000:1000
EXPOSE 8080
CMD ["python3", "-u", "-m", "cache.server"]
